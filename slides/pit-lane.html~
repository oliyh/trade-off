.image-caption { color: var(--cream-soft); }
.credit { color: var(--gold); text-transform: uppercase; letter-spacing: 0.06em; }
img.r-stretch { border: 3px solid var(--gold); filter: saturate(0.9) contrast(1.05); }

.stat-number { color: var(--gold-bright); }
.stat-unit { color: var(--cream-soft); font-family: "Barlow", sans-serif; text-transform: none; }

.s-close blockquote { color: var(--gold-bright); text-transform: uppercase; }
.close-body { color: var(--cream-soft); text-transform: none; font-family: "Barlow", sans-serif; }


.help-hint {
  position: fixed; bottom: 10px; right: 14px; z-index: 40; font-size: 11px;
  font-family: ui-monospace, monospace; opacity: 0.45; letter-spacing: 0.03em; pointer-events: none;
