html, body { margin: 0; height: 100%; overflow: hidden; }
.reveal { height: 100vh; }


.reveal { font-size: 30px; }
.reveal .slides section { text-align: left; padding: 4.5em 5em; box-sizing: border-box; height: 100%; }
.reveal .slides { text-align: left; }
.reveal h1, .reveal h2, .reveal h3 { text-transform: none; text-align: left; text-wrap: balance; }
.reveal p { text-align: left; }
.reveal ul { display: block; margin: 0; }
.reveal blockquote { box-shadow: none; width: auto; margin: 0; }

.no-badge { display: inline-flex; align-items: center; justify-content: center; margin-bottom: 0.6em; }

/* title */
.reveal .slides section.s-title { display: flex !important; flex-direction: column; justify-content: center; height: 100%; gap: 0.5em; }
.eyebrow { font-size: 0.55em; letter-spacing: 0.18em; text-transform: uppercase; margin: 0; }
.deck-title { font-size: 1.7em; line-height: 1.08; margin: 0.1em 0; max-width: 11.5em; }
.deck-subtitle { font-size: 0.62em; max-width: 9em; margin: 0.2em 0; line-height: 1.4; }
.byline { font-size: 0.45em; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 0.8em; }

/* section divider */
.reveal .slides section.s-section { display: flex !important; flex-direction: column; justify-content: center; height: 100%; gap: 0.4em; }
.section-title { font-size: 1.5em; margin: 0.1em 0 0.3em; max-width: 10em; }
.section-quote { font-size: 0.6em; font-style: italic; max-width: 9em; margin: 0; }

/* quote */
.reveal .slides section.s-quote { display: flex !important; flex-direction: column; justify-content: center; align-items: flex-start; height: 100%; gap: 0.6em; }
.s-quote blockquote { font-style: normal; margin: 0; }
.s-quote blockquote::after { content: ""; display: block; clear: left; }
.quote-mark { float: left; margin-top: 0.06em; margin-right: 0.35em; }
.s-quote.quote-big blockquote { font-size: 1.4em; line-height: 1.15; max-width: 24em; }
.s-quote.quote-big .quote-mark { width: 2.3em; height: 2.3em; }
.s-quote.quote-small blockquote { font-size: 1.05em; line-height: 1.2; max-width: 30em; }
.s-quote.quote-small .quote-mark { width: 2.4em; height: 2.4em; }
.s-quote cite { font-size: 0.5em; font-style: normal; letter-spacing: 0.05em; }

/* list */
.reveal .slides section.s-list { display: flex !important; flex-direction: column; justify-content: center; height: 100%; gap: 0.6em; }
.list-heading { font-size: 1.05em; margin: 0 0 0.2em; }
.frag-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5em; }
.frag-list li { font-size: 1em; font-weight: 600; line-height: 1.25; padding-left: 1.1em; position: relative; max-width: 16em; }

/* image — section padding is tightened so the r-stretch image can fill the slide, no supporting copy */
.reveal .slides section.s-image { display: flex !important; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 0.5em; padding: 2.2em !important; }
.s-image img.r-stretch { max-width: 100%; display: block; border-radius: 2px; }
.s-image.img-small img.r-stretch { max-height: 62vh; max-width: 62vh; width: auto; }
.credit { font-size: 0.4em; letter-spacing: 0.04em; margin: 0; }

/* stat */
.reveal .slides section.s-stat { display: flex !important; flex-direction: column; justify-content: center; height: 100%; gap: 0.3em; }
.stat-number { font-size: 3.2em; line-height: 1; margin: 0.15em 0; font-weight: 800; display: flex; align-items: baseline; gap: 0.25em; }
.stat-unit { font-size: 0.26em; font-weight: 500; }
.s-stat .image-caption { font-size: 0.55em; margin: 0; }

/* close */
.reveal .slides section.s-close { display: flex !important; flex-direction: column; justify-content: center; align-items: center; text-align: center; height: 100%; gap: 0.6em; }
.s-close blockquote { font-size: 1.5em; margin: 0; max-width: 10em; }
.close-body { font-size: 0.55em; max-width: 20em; line-height: 1.5; margin: 0; }



:root {
  --black: #0a0a0a; --panel: #141210; --gold: #cda039; --gold-bright: #f1cf7a;
