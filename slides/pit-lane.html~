.reveal .slides section::after { bottom: 10px; }

.eyebrow, .byline, .no-badge-num, .credit, cite, .footline, .stat-number { font-family: "Space Mono", ui-monospace, monospace; }
.eyebrow { color: var(--gold); letter-spacing: 0.3em; }
.byline { color: var(--cream-soft); }

.deck-title { color: var(--cream); font-size: 1.8em; }
.deck-subtitle { color: var(--cream-soft); text-transform: none; letter-spacing: 0; font-family: "Barlow", sans-serif; }

/* racing number roundel */
.no-badge {
